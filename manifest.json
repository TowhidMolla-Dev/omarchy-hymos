{
  "schemaVersion": 1,
  "id": "diogocezar.hymos",
  "name": "Hymos",
  "version": "1.0.0",
  "author": "diogocezar",
  "license": "MIT",
  "description": "Mos-style smooth scrolling for your mouse wheel on Hyprland. Clicks turn into a fluid, eased glide; toggle it and tune intensity and glide from the bar.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "src/Widget.qml"
  },
  "barWidget": {
    "displayName": "Hymos",
    "description": "Smooth mouse-wheel scrolling, like Mos on macOS",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "step": 4,
      "duration": 320,
      "language": "auto"
    },
    "schema": [
      {"key": "enabled", "type": "boolean", "label": "Smooth scrolling on"},
      {"key": "step", "type": "integer", "min": 1, "max": 12, "label": "Intensity (distance per wheel click)"},
      {"key": "duration", "type": "integer", "min": 80, "max": 900, "label": "Glide (ms until the scroll settles)"},
      {"key": "language", "type": "enum", "options": ["auto", "en", "pt", "es", "fr", "de"],
       "defaultValue": "auto", "label": "Language (auto = system locale)"}
    ]
  }
}
