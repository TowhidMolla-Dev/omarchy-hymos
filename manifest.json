{
  "schemaVersion": 1,
  "id": "io.github.TowhidMolla-Dev.omarchy-hymos",
  "name": "Hymos",
  "version": "1.4.0",
  "author": "TowhidMolla-Dev",
  "license": "MIT",
  "description": "Smooth, eased scrolling for your mouse wheel in every app on Hyprland, like Mos on macOS. Turn it on and tune how far and how long each scroll glides from one icon in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "src/Widget.qml"
  },
  "barWidget": {
    "displayName": "Hymos",
    "description": "Smooth mouse-wheel scrolling in every app, like Mos on macOS",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "step": 4,
      "duration": 320,
      "language": "auto",
      "drag_scroll": true,
      "drag_button": "right",
      "drag_direction": "mobile",
      "drag_speed": 100,
      "drag_fling": true,
      "drag_fling_tau": 380,
      "drag_click_suppress": true,
      "curve": "expo",
      "axis_lock": true
    },
    "schema": [
      {
        "key": "enabled",
        "type": "boolean",
        "label": "Smooth scrolling on"
      },
      {
        "key": "step",
        "type": "integer",
        "min": 1,
        "max": 12,
        "label": "Intensity (distance per wheel click)"
      },
      {
        "key": "duration",
        "type": "integer",
        "min": 80,
        "max": 900,
        "label": "Glide (ms until the scroll settles)"
      },
      {
        "key": "language",
        "type": "enum",
        "options": [
          "auto",
          "en",
          "pt",
          "es",
          "fr",
          "de"
        ],
        "defaultValue": "auto",
        "label": "Language (auto = system locale)"
      },
      {
        "key": "drag_scroll",
        "type": "boolean",
        "label": "Drag to scroll"
      },
      {
        "key": "drag_button",
        "type": "enum",
        "options": [
          "left",
          "middle",
          "right"
        ],
        "defaultValue": "right",
        "label": "Drag button"
      },
      {
        "key": "drag_direction",
        "type": "enum",
        "options": [
          "mobile",
          "laptop"
        ],
        "defaultValue": "mobile",
        "label": "Drag direction (mobile = page follows cursor)"
      },
      {
        "key": "drag_speed",
        "type": "integer",
        "min": 0,
        "max": 100,
        "label": "Drag speed (percent)"
      },
      {
        "key": "drag_fling",
        "type": "boolean",
        "label": "Fling"
      },
      {
        "key": "drag_fling_tau",
        "type": "integer",
        "min": 150,
        "max": 900,
        "label": "Coast (ms)"
      },
      {
        "key": "curve",
        "type": "enum",
        "label": "Scroll curve",
        "options": [
          "expo",
          "linear",
          "smooth"
        ]
      },
      {
        "key": "axis_lock",
        "type": "boolean",
        "label": "Lock drag to one axis"
      },
      {
        "key": "drag_click_suppress",
        "type": "boolean",
        "label": "Suppress click after drag"
      }
    ]
  }
}